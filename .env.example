# =============================================================================
# AutoApply AI — Environment Configuration
# Copy this file to .env and fill in your values
# =============================================================================

# --- Database ---
DATABASE_URL=sqlite+aiosqlite:///data/db/autoapply.db
REDIS_URL=redis://localhost:6379/0

# --- LLM Providers (set at least one) ---
# RECOMMENDED: AWS Bedrock (platform-authenticated via the standard AWS credential chain —
# env vars below, or ~/.aws, or an EC2/ECS instance role). No API key is stored per user.
# Bedrock Claude models are cross-region inference profiles → use the "us." prefix, and enable
# model access once in the Bedrock console (Console → Bedrock → Model access → Claude).
LLM__PREFERRED_PROVIDER=bedrock
LLM__DEFAULT_MODEL=bedrock/us.anthropic.claude-sonnet-4-6
LLM__BEDROCK_REGION=us-east-1
# Bedrock Mantle — the OpenAI-compatible Bedrock endpoint exposing the WIDER catalog
# (gpt-oss, DeepSeek, Qwen, GLM-5, Kimi, MiniMax, Mistral Large 3 …). Auth is a short-term
# bearer token self-generated from the same AWS credential chain — just set the URL:
LLM__MANTLE_API_BASE=https://bedrock-mantle.us-east-1.api.aws/v1
# AWS-family fallback models, tried in order when the primary is throttled/unavailable.
# Live-verified Mantle options: mantle/openai.gpt-oss-120b, mantle/deepseek.v3.2,
# mantle/qwen.qwen3-next-80b-a3b-instruct, mantle/zai.glm-5, mantle/moonshotai.kimi-k2.5,
# mantle/mistral.mistral-large-3-675b-instruct, mantle/minimax.minimax-m2.5.
# (xai.grok-4.3 is listed on Mantle but only on the Responses API and currently times out.)
LLM__FALLBACK_PROVIDERS=["mantle/openai.gpt-oss-120b","bedrock/google.gemma-3-27b-it"]
# AWS credentials for Bedrock (or leave blank to use ~/.aws / an instance role):
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# Alternative providers (BYO per-user keys entered in Settings, or global fallbacks here):
LLM__PORTKEY_API_KEY=
LLM__OPENAI_API_KEY=
LLM__GROQ_API_KEY=
LLM__GEMINI_API_KEY=
LLM__OPENROUTER_API_KEY=
LLM__GITHUB_TOKEN=
LLM__TEMPERATURE=0.7
LLM__MAX_TOKENS=4096
# Monthly LLM budget per user in USD (calendar month UTC, default 5.0; <= 0 disables).
# When exceeded, subsequent LLM calls and agent runs fail closed with HTTP 402 Payment Required.
LLM__USER_MONTHLY_BUDGET_USD=5.0

# --- Browser Automation ---
BROWSER__HEADLESS=true
BROWSER__MAX_PARALLEL=3
# Platform logins are stored per-user, encrypted, via the session-import API (POST /api/v1/platform-sessions).
BROWSER__USER_DATA_DIR=./data/sessions/chrome_profile
BROWSER__KEEP_ALIVE=true
BROWSER__MAX_STEPS=50
BROWSER__MAX_FAILURES=3
BROWSER__STEP_TIMEOUT=120
BROWSER__USE_VISION=auto
# SAFETY GATE: keep false until the headful real-browser spike is validated (assisted login,
# anti-bot posture, human-in-the-loop for CAPTCHA/2FA). When false, no live submissions happen.
BROWSER__LIVE_APPLY=false
# Seconds the apply agent waits for the user to answer a CAPTCHA/2FA prompt before giving up:
BROWSER__INTERVENTION_TIMEOUT_S=300
# Individual board search timeout (seconds) during concurrent discovery:
BROWSER__SEARCH_TIMEOUT_S=90

# --- Job Discovery ---
# Exa AI semantic search for finding jobs across the web (optional)
EXA_API_KEY=

# --- Application Behavior ---
APPLY_MODE=review
# Options: autonomous, review, batch
# ATS threshold is now configured per-user in Settings (Settings → min_ats_score; defaults to 0.75)
# Note: Worker job_timeout is 30 min; the reaper fails stale APPLYING applications after 45 min.
ENVIRONMENT=development
LOG_LEVEL=INFO

# --- Auth & Security (multi-tenant) ---
# JWT signing secret — MUST be a strong random value in production.
AUTH__SECRET_KEY=dev-insecure-change-me
AUTH__ACCESS_TOKEN_EXPIRE_MINUTES=15
AUTH__REFRESH_TOKEN_EXPIRE_DAYS=30
AUTH__WS_TICKET_EXPIRE_SECONDS=60

# --- Secrets (per-user BYO-key envelope encryption) ---
# Comma-separated Fernet keys (first = current KEK). Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Leave empty outside production to auto-generate an ephemeral dev key.
SECRETS__PROVIDER=local
SECRETS__APP_KEYS=

# --- File Storage ---
STORAGE__PROVIDER=local
STORAGE__LOCAL_ROOT=./data/storage
STORAGE__URL_SIGNING_SECRET=dev-insecure-change-me
# For S3-compatible storage (AWS S3 / Cloudflare R2 / MinIO) set STORAGE__PROVIDER=s3 and:
# STORAGE__BUCKET=autoapply
# STORAGE__REGION=auto
# STORAGE__ENDPOINT_URL=https://<account>.r2.cloudflarestorage.com
# STORAGE__ACCESS_KEY_ID=
# STORAGE__SECRET_ACCESS_KEY=

# --- Email (password-reset delivery) ---
# provider=log (default) writes the reset link to the logs — the flow works end-to-end in dev/CI
# with NO mail server. Set provider=smtp + the SMTP fields below for real delivery (any relay:
# your mailbox provider, AWS SES SMTP, Mailgun, Postmark, …).
EMAIL__PROVIDER=log
EMAIL__FROM_ADDRESS=no-reply@autoapply.ai
EMAIL__FROM_NAME=AutoApply AI
# Frontend origin used to build the reset link the user clicks (set to your deployed FE URL in prod):
EMAIL__FRONTEND_BASE_URL=http://localhost:3000
EMAIL__RESET_TOKEN_EXPIRE_MINUTES=30
# For real delivery (EMAIL__PROVIDER=smtp):
# EMAIL__SMTP_HOST=email-smtp.us-east-1.amazonaws.com
# EMAIL__SMTP_PORT=587
# EMAIL__SMTP_USERNAME=
# EMAIL__SMTP_PASSWORD=
# EMAIL__SMTP_STARTTLS=true

# --- Server ---
CORS_ORIGINS=["http://localhost:3000", "http://localhost:5173"]

# --- Observability ---
# Bearer token guarding /metrics in production (generate: python -c "import secrets; print(secrets.token_urlsafe(24))"):
METRICS_TOKEN=
# Optional error tracking — Sentry stays a no-op until a DSN is set:
SENTRY_DSN=
