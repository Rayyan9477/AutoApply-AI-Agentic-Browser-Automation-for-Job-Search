# ── Production environment (copy to .env.prod; NEVER commit the real file) ──────────────
# Generate secrets:
#   AUTH__SECRET_KEY:    python -c "import secrets; print(secrets.token_urlsafe(48))"
#   SECRETS__APP_KEYS:   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#   METRICS_TOKEN:       python -c "import secrets; print(secrets.token_urlsafe(24))"

ENVIRONMENT=production
LOG_LEVEL=INFO

# ── Database — Neon Postgres (free tier). asyncpg uses the `ssl` query param, NOT libpq
#    `sslmode` (writing ?sslmode=require makes asyncpg raise TypeError at first connect). ─────
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/autoapply?ssl=require

# ── Redis — the in-stack container ──────────────────────────────────────────────────────
# Note: Worker job_timeout is 30 min (1800s); automated reaper fails stale APPLYING tasks after 45 min.
REDIS_URL=redis://redis:6379/0

# ── Auth ────────────────────────────────────────────────────────────────────────────────
AUTH__SECRET_KEY=CHANGE_ME_long_random_string

# ── Secrets-at-rest (Fernet envelope; first key is the current KEK, comma-separated) ─────
SECRETS__PROVIDER=local
SECRETS__APP_KEYS=CHANGE_ME_fernet_key

# ── Object storage — Cloudflare R2 (S3-compatible). Create a bucket + an R2 API token. ──
STORAGE__PROVIDER=s3
STORAGE__BUCKET=autoapply
STORAGE__REGION=auto
STORAGE__ENDPOINT_URL=https://ACCOUNT_ID.r2.cloudflarestorage.com
STORAGE__ACCESS_KEY_ID=CHANGE_ME_r2_access_key
STORAGE__SECRET_ACCESS_KEY=CHANGE_ME_r2_secret_key

# ── Metrics scrape token (required to read /metrics in production) ───────────────────────
METRICS_TOKEN=CHANGE_ME_metrics_token

# ── CORS — your frontend origin(s), comma-separated JSON-style list ─────────────────────
CORS_ORIGINS=["https://app.example.com"]

# ── Caddy TLS — the API's public hostname ───────────────────────────────────────────────
DOMAIN=api.example.com

# ── Browser automation — keep the live apply OFF until the assisted-login spike is ready ─
BROWSER__LIVE_APPLY=false
BROWSER__HEADLESS=true
BROWSER__MAX_PARALLEL=1
# Seconds the apply agent waits for the user to answer a CAPTCHA/2FA prompt before giving up:
BROWSER__INTERVENTION_TIMEOUT_S=300
# Timeout (seconds) for individual board searches during concurrent discovery:
BROWSER__SEARCH_TIMEOUT_S=90
# Note: ATS threshold is configured per-user in Settings (Settings → min_ats_score)

# ── LLM — AWS Bedrock is the default (platform-authenticated; no per-user key). Enable model
#    access in the Bedrock console and grant bedrock:InvokeModel. Claude on Bedrock needs the
#    cross-region inference-profile "us." prefix. Per-user BYO keys still work as an alternative. ─
LLM__PREFERRED_PROVIDER=bedrock
LLM__DEFAULT_MODEL=bedrock/us.anthropic.claude-sonnet-4-6
LLM__BEDROCK_REGION=us-east-1
# Bedrock Mantle (OpenAI-compatible endpoint, wider catalog; bearer auth self-generated
# from the AWS credential chain — nothing else to configure):
LLM__MANTLE_API_BASE=https://bedrock-mantle.us-east-1.api.aws/v1
# Fallbacks: gpt-oss-120B via Mantle, then Gemma 3 27B via Converse.
LLM__FALLBACK_PROVIDERS=["mantle/openai.gpt-oss-120b","bedrock/google.gemma-3-27b-it"]
# Credentials: set these, OR attach an instance role to the VPS and leave them blank.
AWS_ACCESS_KEY_ID=CHANGE_ME_or_use_instance_role
AWS_SECRET_ACCESS_KEY=CHANGE_ME_or_use_instance_role
AWS_REGION=us-east-1
# Per-user monthly LLM spend limit in USD (calendar month UTC, default $5.0; <=0 disables; HTTP 402 on breach):
LLM__USER_MONTHLY_BUDGET_USD=5.0

# ── Email — password-reset delivery. provider=log writes the link to logs (no mail server);
#    set provider=smtp + creds for real delivery (e.g. AWS SES SMTP). ─────────────────────────
EMAIL__PROVIDER=log
EMAIL__FROM_ADDRESS=no-reply@example.com
EMAIL__FRONTEND_BASE_URL=https://app.example.com
# EMAIL__PROVIDER=smtp
# EMAIL__SMTP_HOST=email-smtp.us-east-1.amazonaws.com
# EMAIL__SMTP_PORT=587
# EMAIL__SMTP_USERNAME=CHANGE_ME
# EMAIL__SMTP_PASSWORD=CHANGE_ME
# EMAIL__SMTP_STARTTLS=true

# ── Error tracking (optional) — set to enable Sentry for API + worker ────────────────────
# SENTRY_DSN=
